
# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production
PORT=5000
HOST=0.0.0.0

# Database Configuration - Development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hubspot_data
DB_USER=postgres
DB_PASSWORD=your-existing-development-password
DB_SCHEMA=hubspot_deals

# DLT Configuration
DLT_PIPELINE_NAME=hubspot_deals
DLT_WORKING_DIR=.dlt

# HubSpot API Configuration
HUBSPOT_ACCESS_TOKEN=pat-na1-your-token-here
HUBSPOT_API_BASE_URL=https://api.hubapi.com
HUBSPOT_API_TIMEOUT=30
HUBSPOT_API_RATE_LIMIT=150
HUBSPOT_RATE_LIMIT_WINDOW_SECONDS=10

# Service Configuration
MAX_CONCURRENT_SCANS=5
SCAN_TIMEOUT_HOURS=24
CLEANUP_DAYS=7

# Logging Configuration
LOG_LEVEL=INFO
LOKI_ENABLED=false
LOKI_URL=http://localhost:3100
LOKI_USERNAME=
LOKI_PASSWORD=
